# Upstream versions drigodb pins.
#
# Single source of truth: scripts/cnpg-install.sh sources this file, so a
# version bump is one edit here.
#
# It used to pin PostgreSQL for the backup image drigodb built, and DocumentDB
# before that. Both are gone — see docs/leaving-documentdb.md and decision 0004
# — and the PostgreSQL version now comes from whichever CloudNativePG image an
# installation configures, which is drigodb.pgImage rather than a build input.

# The CloudNativePG operator drigodb requires on the cluster. Decision 0004.
#
# Not an image: it is the release whose manifest scripts/cnpg-install.sh applies.
# Pinned for the same reason every image here is — an operator that upgrades
# itself because someone re-ran an installer is an operator that changed the
# data plane without anyone deciding to.
#
# Moving it is a deliberate act. #70 covers making that a pull request rather
# than an edit someone remembers to make.
CNPG_VERSION=1.27.0
CNPG_RELEASE_BRANCH=release-1.27

# cert-manager. Required by the barman-cloud plugin below, which ships two
# Certificates and an Issuer and does not start without it.
#
# Note what this changes: cert-manager used to be optional here, needed only by
# an installation that turned server authentication on. An installation that
# wants backups now needs it too.
CERT_MANAGER_VERSION=v1.16.2

# The CloudNativePG backup plugin. Decision 0004 gave the pod template to the
# operator, which took drigodb's backup sidecar with it; this is what replaces
# it. See issue #95.
#
# The plugin rather than spec.backup.barmanObjectStore, which works on 1.27 and
# is REMOVED in CloudNativePG 1.28. Nothing in the CRD schema says so — only the
# admission webhook does, on apply.
#
# A 0.x component shipping roughly monthly, so this pin will move more often
# than the others. #97 puts it somewhere Dependabot can read.
BARMAN_PLUGIN_VERSION=v0.15.0

{
  "name": "drigodb",
  "version": "0.0.1",
  "private": true,
  "description": "PostgreSQL databases, provisioned through an API on Kubernetes — hibernating when idle, waking in seconds.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@kubernetes/client-node": "^1.4.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}

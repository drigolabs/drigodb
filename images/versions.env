# The upstream version the drigodb backup image is built against.
#
# Single source of truth: scripts/publish-images.sh sources this file and
# .github/workflows/images.yml reads it, so a version bump is one edit here and
# CI rebuilds, tests and publishes from it.
#
# DOCUMENTDB_VERSION used to live here too, pinning the extension and the
# gateway. Both are gone — see docs/leaving-documentdb.md — and the postgres
# image is now CNPG's own, so this file no longer names anything drigodb builds
# a server from.
PG_MAJOR=18

# The CloudNativePG operator drigodb requires on the cluster. Decision 0004.
#
# Not an image: it is the release whose manifest scripts/cnpg-install.sh applies.
# Pinned for the same reason every image here is — an operator that upgrades
# itself because someone re-ran an installer is an operator that changed the
# data plane without anyone deciding to.
#
# Moving it is a deliberate act. #70 covers making that a pull request rather
# than an edit someone remembers to make.
CNPG_VERSION=1.27.0
CNPG_RELEASE_BRANCH=release-1.27

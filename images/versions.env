# The upstream version the drigodb backup image is built against.
#
# Single source of truth: scripts/publish-images.sh sources this file and
# .github/workflows/images.yml reads it, so a version bump is one edit here and
# CI rebuilds, tests and publishes from it.
#
# DOCUMENTDB_VERSION used to live here too, pinning the extension and the
# gateway. Both are gone — see docs/leaving-documentdb.md — and the postgres
# image is now CNPG's own, so this file no longer names anything drigodb builds
# a server from.
PG_MAJOR=18
